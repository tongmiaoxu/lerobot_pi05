<mujoco model="xarm7 book scene">
  <include file="xarm7_book.xml"/>
  <include file="book.xml"/>

  <statistic center="0.2 0 0.4" extent=".65"/>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-20"/>
    <quality shadowsize="0"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="shelf_mat" rgba="0.55 0.48 0.40 1" specular="0.1" shininess="0.1"/>
  </asset>

  <worldbody>
    <!-- All positions are in MuJoCo world frame: origin at (0,0,0), Z up. -->
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" castshadow="false"
           diffuse="0.5 0.5 0.5" specular="0 0 0"/>
    <geom type="cylinder" size=".06 .06" pos="0 0 .06" rgba="1 1 1 1"/>

    <body name="table" pos="0.9700 0.0000 -0.0950" euler="0.0000 0.0000 -0.0524">
      <geom name="table" type="box" size="0.8 1.5 0.05"
            rgba="0 0 0 1"
            friction="2 0.05 0.01"
            solref="0.004 1"
            solimp="0.95 0.99 0.001"/>
    </body>

    <!-- Keep local Z upright so the book stands on the table. -->
    <body name="book" pos="0.4885 -0.1863 0.0887" quat="1.0000 0.0000 0.0000 0.0000">
      <freejoint name="book_joint"/>
      <include file="book_collision.xml"/>
    </body>

    <!-- Fixed book-shelving target: two books on the left bookend, one book on the right. -->
    <body name="book_shelf_target" pos="0.5000 0.2350 -0.0450">
      <geom name="left_bookend_visual" type="mesh" mesh="bookend" material="bookend_visual_mat"
            pos="-0.0110 0.0630 0.1710" euler="3.14159265 0 1.57079633"
            contype="0" conaffinity="0" mass="0"/>
      <geom name="left_bookend_col" type="mesh" mesh="bookend" class="book_target_collision"
            pos="-0.0110 0.0630 0.1710" euler="3.14159265 0 1.57079633"/>

      <geom name="i_book_target_visual" type="mesh" mesh="i_book_visual" material="i_book_visual_mat"
            pos="-0.0950 0.0000 0.1261" contype="0" conaffinity="0" mass="0"/>
      <geom name="i_book_target_col" type="mesh" mesh="i_book_collision" class="book_target_collision"
            pos="-0.0950 0.0000 0.1261"/>

      <geom name="l_book_target_visual" type="mesh" mesh="l_book_visual" material="l_book_visual_mat"
            pos="-0.0450 0.0000 0.1346" contype="0" conaffinity="0" mass="0"/>
      <geom name="l_book_target_col" type="mesh" mesh="l_book_collision" class="book_target_collision"
            pos="-0.0450 0.0000 0.1346"/>

      <geom name="d_book_target_visual" type="mesh" mesh="d_book_visual" material="d_book_visual_mat"
            pos="0.0780 0.0000 0.1231" contype="0" conaffinity="0" mass="0"/>
      <geom name="d_book_target_col" type="mesh" mesh="d_book_collision" class="book_target_collision"
            pos="0.0780 0.0000 0.1231"/>

      <geom name="right_bookend_visual" type="mesh" mesh="bookend" material="bookend_visual_mat"
            pos="-0.0040 -0.0630 0.1710" euler="3.14159265 0 -1.57079633"
            contype="0" conaffinity="0" mass="0"/>
      <geom name="right_bookend_col" type="mesh" mesh="bookend" class="book_target_collision"
            pos="-0.0040 -0.0630 0.1710" euler="3.14159265 0 -1.57079633"/>
    </body>


    <!-- Stationary camera: pose overridden at runtime from visual_match/configs/stationary_cam.json -->
    <camera name="stationary_cam" pos="0.5 0.0 0.8" xyaxes="0 -1 0 0.5 0 1"
            fovy="62.74"/>
  </worldbody>

</mujoco>
