<mujoco model="xarm7 scene">
  <include file="xarm7_hang.xml"/>
  <include file="mug.xml"/>
  <include file="rack.xml"/>

  <statistic center="0.2 0 0.4" extent=".65"/>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-20"/>
    <quality shadowsize="0"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

  </asset>

  <worldbody>
    <!-- All positions are in MuJoCo world frame: origin at (0,0,0), Z up -->
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" castshadow="false"
           diffuse="0.5 0.5 0.5" specular="0 0 0"/>
    <geom type="cylinder" size=".06 .06" pos="0 0 .06" rgba="1 1 1 1"/>

    <body name="table" pos="0.9650 0.0000 -0.0950" euler="0.0000 0.0000 -0.0524">
      <geom name="table" type="box" size="0.8 1.5 0.05"
            rgba="0 0 0 1"
            friction="2 0.05 0.01"
            solref="0.004 1"
            solimp="0.95 0.99 0.001"/>
    </body>

    <!-- <body name="mug" pos="0.4284 -0.1984 -0.0439" euler="0.0000 0.0000 -4.7997"> -->
    <body name="mug" pos="0.4284 -0.1984 -0.0439" euler="0.0000 0.0000 1.5186">
      <freejoint name="mug_joint"/>
      <include file="mug_collision.xml"/>
    </body>

    <body name="rack" pos="0.3615 0.0910 -0.0500" euler="0.0000 0.0000 -1.6122">
      <include file="rack_collision.xml"/>
    </body> 

    <!-- Stationary camera: pose overridden at runtime from visual_match/configs/stationary_cam.json -->
    <camera name="stationary_cam" pos="0.5 0.0 0.8" xyaxes="0 -1 0 0.5 0 1"
            fovy="62.74"/>
  </worldbody>

</mujoco>
