<mujoco model="xarm7 scene">
  <include file="xarm7.xml"/>
  <include file="mug.xml"/>

  <statistic center="0.2 0 0.4" extent=".65"/>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-20"/>
    <quality shadowsize="0"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <!-- Matte material: no specular highlights so colors render true (e.g. pink sticker) -->
    <material name="matte_pink" specular="0" shininess="1" reflectance="0"/>
  </asset>

  <worldbody>
    <!-- All positions are in MuJoCo world frame: origin at (0,0,0), Z up -->
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" castshadow="false"
           diffuse="0.5 0.5 0.5" specular="0 0 0"/>
    <geom type="cylinder" size=".06 .06" pos="0 0 .06" rgba="1 1 1 1"/>

    <body name="table" pos="0.9700 0.0000 -0.095" euler="0 0 -0.0524">
      <geom name="table" type="box" size="0.8 1.5 0.05"
            rgba="0 0 0 1"
            friction="2 0.05 0.01"
            solref="0.004 1"
            solimp="0.95 0.99 0.001"/>
    </body>

    <!-- <body name="mug" pos="0.5634 -0.1034 -0.038860" euler="0 0 1.5708"> -->
    <body name="mug" pos="0.3834 -0.1284 -0.0389" euler="0 0 4.7124">
      <freejoint name="mug_joint"/>
      <include file="mug_collision.xml"/>
    </body>

    <!-- Cube: 28mm, color rgb(2,102,193), MuJoCo world-frame pose [541.5,-11,-56.9,180,0,0] -->
    <!-- <body name="cube" pos="0.5286 0.0086 0.0771">
      <freejoint name="cube_joint"/>
      <geom name="cube" type="box" size="0.014 0.017 0.014"
            rgba="0.008 0.4 0.757 1" mass="0.01"/> 
    </body>-->
    <body name="sticker" pos="0.3915 0.1410 -0.0450"> 
      <geom name="sticker" type="box" size="0.036 0.036 0.0005"
            material="matte_pink" rgba="0.996 0.698 0.706 1" mass="0"/>
    </body> 

    <!-- Stationary camera: pose overridden at runtime from visual_match/configs/stationary_cam.json -->
    <camera name="stationary_cam" pos="0.5 0.0 0.8" xyaxes="0 -1 0 0.5 0 1"
            fovy="62.74"/>
  </worldbody>

</mujoco>
